rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catalogue Produits : lecture publique, écriture réservée aux administrateurs
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Catégories : lecture publique, écriture réservée aux administrateurs
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Commandes : 
    // - Création publique avec validation stricte du schéma (statut 'pending', montant > 0, items non vides, infos client requises)
    // - Lecture, modification et suppression réservées exclusivement aux administrateurs authentifiés
    match /orders/{orderId} {
      allow create: if request.resource.data.status == "pending"
                    && request.resource.data.total is number
                    && request.resource.data.total > 0
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.customer is map
                    && request.resource.data.customer.name is string
                    && request.resource.data.customer.name.size() >= 2
                    && request.resource.data.customer.phone is string
                    && request.resource.data.customer.phone.size() >= 8
                    && request.resource.data.customer.address is string
                    && request.resource.data.customer.address.size() >= 5
                    && request.resource.data.customer.city is string
                    && request.resource.data.customer.city.size() >= 2
                    && request.resource.data.createdAt is string;

      allow read, update, delete: if request.auth != null;
    }
  }
}
